{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ois-api-proxy",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-19",
  "routes": [{ "pattern": "ois.atlair.cloud", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "API_ORIGIN": "https://ois-ledger-vuq3vqgw6q-el.a.run.app"
  },
  "secrets": {
    "required": ["PROXY_SHARED_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
