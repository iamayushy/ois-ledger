{
  "name": "@ois/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.mjs",
    "build": "tsc --noEmit && pnpm run bundle",
    "bundle": "esbuild server=src/server.ts migrate=../../packages/db/src/migrate-cli.ts seed=../../packages/db/src/seed.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@ois/db=../../packages/db/src --alias:@ois/shared=../../packages/shared/src --outdir=dist --out-extension:.js=.mjs --sourcemap --legal-comments=none",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/etag": "^6.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@fastify/under-pressure": "^9.0.3",
    "@ois/db": "workspace:*",
    "@ois/shared": "workspace:*",
    "close-with-grace": "^2.1.0",
    "drizzle-orm": "^0.43.1",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.15.6"
  },
  "devDependencies": {
    "@types/pg": "^8.11.14",
    "esbuild": "0.28.2",
    "tsx": "^4.19.4"
  }
}
